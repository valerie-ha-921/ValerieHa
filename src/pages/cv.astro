---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/url";
---

<Layout title="CV" wide>
  <h1 data-reveal>CV</h1>
  <p class="prose" data-reveal>
    <a class="action" href={withBase("/resume.pdf")} download>Download PDF</a>
  </p>

  <iframe
    class="cv-embed"
    src={withBase("/resume.pdf")}
    title="Valerie Ha — curriculum vitae (PDF)"
    loading="lazy"
    data-reveal></iframe>
</Layout>
