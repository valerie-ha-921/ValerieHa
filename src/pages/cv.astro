---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/url";
---

<Layout title="CV">
  <p class="section-label">CV</p>
  <h1>CV</h1>

  <p>
    <a href={withBase("/resume.pdf")} download>Download PDF</a>
  </p>

  <iframe
    src={withBase("/resume.pdf")}
    width="100%"
    height="900"
    style="border: none;"
    title="Resume PDF"
  ></iframe>
</Layout>