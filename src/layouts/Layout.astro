---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { withBase } from "../utils/url";
import Trajectories from "../components/Trajectories.astro";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = "Valerie Ha — computational neuroscience, machine learning, and quantum engineering. Research, projects, and writing.",
  wide = false,
} = Astro.props;

const navItems = [
  { href: "/research", label: "Research" },
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
  { href: "/cv", label: "CV" },
  { href: "/contact", label: "Contact" },
];

const here = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string) => {
  const h = withBase(href).replace(/\/$/, "");
  return here === h || (href !== "/" && here.startsWith(h + "/"));
};
const year = new Date().getFullYear();
const pageTitle = /valerie\s*ha/i.test(title) ? title : `${title} — Valerie Ha`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link
      rel="preload"
      href={withBase("/fonts/spectral-500.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase("/fonts/archivo-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <Trajectories />

    <div class="site-shell">
      <nav class="site-nav" aria-label="Primary">
        <a class="nav-home" href={withBase("/")} aria-current={here === "" ? "page" : undefined}
          >Valerie&nbsp;Ha</a
        >
        {
          navItems.map((item) => (
            <a
              href={withBase(item.href)}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <main class={`site-wrap${wide ? " is-wide" : ""}`} transition:animate="fade">
        <slot />
      </main>

      <footer class="site-footer">
        <span>Valerie Ha</span>
        <span>
          <a href="mailto:valerieha@uchicago.edu">valerieha@uchicago.edu</a>
        </span>
        <span>Updated {year}</span>
      </footer>
    </div>
  </body>
</html>
